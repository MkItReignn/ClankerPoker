[0.000, "o", "\u001b[35;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[35;165H\r\n\u001b[35;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[35;268H\r\n\u001b[36;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                                                                                 \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[36;165H\r\n\u001b[36;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[36;268H\r\n\u001b[37;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[37;3H\u001b[3;38;2;56;176;0;48;2;13;13;13mThe Joker:\u001b[0m\u001b[48;2;13;13;13m                                                                                                                                                       \u001b[0m\u001b[37;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[37;165H\r\n\u001b[37;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2"]
[0.000, "o", ";224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[37;268H\r\n\u001b[38;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Ohohoho, what do we have here? Big blinds in this tournament are massive - 600! And look who we've got at the table... Jack Sparrow, Batman, and The Donald \u001b[0m\u001b[48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;165H\r\n\u001b[38;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;268H\r\n\u001b[39;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[39;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mhimself! *giggles*\"\u001b[0m\u001b[48;2;13;13;13m                                                                                                                                            \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[39;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[39;16"]
[0.000, "o", "5H\r\n\u001b[39;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[39;268H\r\n\u001b[40;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[40;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Ace-King suited... such a \"premium hand\" as the nits would say. But why play it the boring way? These stacks are pretty shallow with these blinds - we're all \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[40;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[40;165H\r\n\u001b[40;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[40;268H\r\n\u001b[41;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[41;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13msitting around 16 big blinds. The \"correct\" play would be to shove here... which is exactly why we shouldn't!\"\u001b[0m\u001b[48;2;13;13;13m                                                 \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[41;164H\u001b[48;2;1"]
[0.000, "o", "3;13;13m \u001b[0m\u001b[41;165H\r\n\u001b[41;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[41;268H\r\n\u001b[42;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[42;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"*adjusts tie* You see, chaos isn't about being random - it's about being unpredictable while still having a plan. If we min-raise here to 1200, we'll drive \u001b[0m\u001b[48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[42;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[42;165H\r\n\u001b[42;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[42;268H\r\n\u001b[43;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[43;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mthem absolutely crazy. They'll be thinking \"Is he strong? Is he weak? Has he lost his mind?\" And that's exactly where we want them.\"\u001b[0m\u001b[48;2;13;13;13m                           \u001b["]
[0.000, "o", "0m\u001b[48;2;13;13;13m \u001b[0m\u001b[43;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[43;165H\r\n\u001b[43;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[43;268H\r\n\u001b[44;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[44;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Plus, look at our position - UTG with the whole table to act behind us. A min-raise here looks so suspicious it might just work. And if someone shoves over \u001b[0m\u001b[48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[44;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[44;165H\r\n\u001b[44;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[44;268H\r\n\u001b[45;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[45;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mus? Well... *grins* ... that's just part of the fun. We've got Ace-King to call with anyway!\"\u001b[0m\u001b[48;2;13;13;13m                            "]
[0.000, "o", "                                      \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[45;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[45;165H\r\n\u001b[45;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[45;268H\r\n\u001b[46;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[46;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Let's give them something to talk about. Why so serious about sizing?\"\u001b[0m\u001b[48;2;13;13;13m                                                                                        \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[46;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[46;165H\r\n\u001b[46;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[46;268H\r\n\u001b[47;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                                                 "]
