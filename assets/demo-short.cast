[0.000, "o", "                                                                          \u001b[0m\u001b[44;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[44;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[44;165H\r\n\u001b[44;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[44;268H\r\n\u001b[45;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[45;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Alright, here we are in the heat of battle, and the board's flopped a couple of Jacks and a 9. Not exactly my favorite hand to be holding with 2♦ Q♥. I \u001b[0m\u001b[48;2;13;13;13m    \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[45;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[45;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[45;165H\r\n\u001b[45;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[45;268H\r\n\u001b[46;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[46;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;"]
[0.000, "o", "13;13mmean, I’ve got a decent high card, but this is a dry board for me. Patrick just made it quite spicy by putting in a hefty raise to 2500 after I limped in, \u001b[0m\u001b[48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[46;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[46;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[46;165H\r\n\u001b[46;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[46;268H\r\n\u001b[47;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[47;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mand now I'm faced with a tough decision. The Joker called, and Agent 007’s in the mix too.\"\u001b[0m\u001b[48;2;13;13;13m                                                                  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[47;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[47;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[47;165H\r\n\u001b[47;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                        "]
