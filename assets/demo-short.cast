[0.000, "o", ";223;223;223;48;2;13;13;13m\"Look at Patrick the Star, charging in with that re-raise preflop like he's got pocket rockets. And now he's leading into three people on a Jack-heavy board?\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[57;162H\u001b[38;2;0;48;84;48;2;0;0;0m▃▃\u001b[0m\u001b[57;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[57;165H\r\n\u001b[57;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[57;268H\r\n\u001b[58;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[58;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mEither he's got a Jack and is about to have a very bad day, or he's trying to bully with air. Either way... *sinister grin*\"\u001b[0m\u001b[48;2;13;13;13m                                 \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[58;162H\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[58;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[58;165H\r\n\u001b[58;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                          "]
[0.000, "o", "         \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[58;268H\r\n\u001b[59;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[59;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Sparrow and Agent 007 are still hanging around too - quite the party we've got here! My Ace-King is basically a glorified napkin right now, but that's \u001b[0m\u001b[48;2;13;13;13m     \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[59;162H\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[59;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[59;165H\r\n\u001b[59;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[59;268H\r\n\u001b[60;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[60;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mexactly why it's perfect. Nobody puts The Joker in a corner with some silly \"correct play.\"\"\u001b[0m\u001b[48;2;13;13;13m                                                                 \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[60;162H\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[60;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[60;165H\r\n\u001b[60;167H\u001b[48;2;13;13;13m"]
[0.000, "o", " \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[60;268H\r\n\u001b[61;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[61;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"They're all trying so hard to tell a story about strength. But you know what's more fun than folding? Making them squirm. Making them wonder. Show these \u001b[0m\u001b[48;2;13;13;13m   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[61;162H\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[61;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[61;165H\r\n\u001b[61;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[61;268H\r\n\u001b[62;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[62;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"serious\" players that their precious hand reading means nothing when chaos enters the game.\"\u001b[0m\u001b[48;2;13;13;13m                                                                \u001b[0m\u001b[48;"]
