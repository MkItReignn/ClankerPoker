[0.000, "o", "                     \u001b[0m\u001b[51;162H\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[51;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[51;165H\r\n\u001b[52;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[52;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Ohohoho, now THIS is getting interesting! Ace-King suited in early position, I raise like a good little boy, and suddenly everyone wants to party! Agent 007\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[52;162H\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[52;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[52;165H\r\n\u001b[53;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[53;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13msmooth calls (trying to be sneaky, are we?), and then our friend in the big blind decides to make things spicy with that reraise to 2500.\"\u001b[0m\u001b[48;2;13;13;13m                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[53;162H\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[53;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[53;165H\r\n\u001b[54;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[54;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"*giggles maniacally*\"\u001b[0m\u001b[48;2;13;13;13m                                             "]
