[0.000, "o", "That’s a hefty bet, and he might have something solid. Patrick the Star in the big blind has already tossed in his 600, and Agent\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[32;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[32;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[32;165H\r\n\u001b[32;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[32;268H\r\n\u001b[33;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[33;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m007 just called the raise.\"\u001b[0m\u001b[48;2;13;13;13m                                                                                                                                  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[33;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[33;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[33;165H\r\n\u001b[33;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[33;268H\r\n\u001b[34;2H\u001b["]
[0.000, "o", "48;2;13;13;13m \u001b[0m\u001b[34;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Hmm, but if he has a big pair or ace-king, I could be in a world of hurt. Do I really want to commit more chips here with a hand that plays better \u001b[0m\u001b[48;2;13;13;13m         \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[34;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[34;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[34;165H\r\n\u001b[34;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[34;268H\r\n\u001b[35;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[35;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mpost-flop? But I’ve got the chips to play with, and I’ve seen The Joker make moves before that seemed strong but were just smoke and mirrors.\"\u001b[0m\u001b[48;2;13;13;13m               \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[35;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[35;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[35;165H\r\n\u001b[35;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m              "]
