[0.000, "o", "                           \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\r\n\u001b[52;1H\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                        \u001b[0m\u001b[38;2;196;197;181;48;2;13;13;13m[J♠]\u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m \u001b[0m\u001b[38;2;244;0;95;48;2;13;13;13m[J♦]\u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m \u001b[0m\u001b[38;2;244;0;95;48;2;13;13;13m[9♥]\u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                         \u001b[0m\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\r\n\u001b[53;1H\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;1"]
[0.000, "o", "3m                                                                                                                                                               \u001b[0m\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\r\n\u001b[54;1H\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[3;38;2;155;93;229;48;2;13;13;13mJack Sparrow:\u001b[0m\u001b[48;2;13;13;13m                                                                                                                                                  \u001b[0m\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                      "]
[0.000, "o", "                                                             \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\r\n\u001b[55;1H\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Alright, here we are in the heat of battle, and the board's flopped a couple of Jacks and a 9. Not exactly my favorite hand to be holding with 2♦ Q♥. I \u001b[0m\u001b[48;2;13;13;13m    \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\r\n\u001b[56;1H\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mmean, I’ve got a decent high card, but this is a dry board for me. Patrick just made it quite spicy"]
[0.000, "o", " by putting in a hefty raise to 2500 after I limped in, \u001b[0m\u001b[48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;0;48;84;48;2;0;0;0m▅▅\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\r\n\u001b[57;1H\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mand now I'm faced with a tough decision. The Joker called, and Agent 007’s in the mix too.\"\u001b[0m\u001b[48;2;13;13;13m                                                                  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                          "]
[0.000, "o", "                                         \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\r\n\u001b[58;1H\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Now, let's think about what they might have. Patrick could be holding a Jack, or maybe even a pocket pair. The Joker’s hanging on for dear life too, so he \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\r\n\u001b[59;1H\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mcould have anything from a straight draw to a weak hand trying to catch up. And I've got to consider that I’ve invested "]
[0.000, "o", "quite a bit already.\"\u001b[0m\u001b[48;2;13;13;13m                \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\r\n\u001b[60;1H\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"If I check, I can see what Patrick does next. But if I bet out, I might get called by someone thinking they can take the pot from me. Do I really want to \u001b[0m\u001b[48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                "]
[0.000, "o", "                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\r\n\u001b[61;1H\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mrisk my whole stack here? There's a lot of uncertainty swarming around this table, and I’m feeling the weight of my chips like a pirate carrying his loot.\"\u001b[0m\u001b[48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\r\n\u001b[62;1H\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"I could go all-in and make a stand—it’s full of drama, and maybe they’ll think I’ve got something fierce. But then again, if they call "]
[0.000, "o", "and I’m behind, it’s \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\r\n\u001b[63;1H\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13ma one-way ticket to Davy Jones’ locker. Hmm, maybe I check and see if the seas calm down a bit.\"\u001b[0m\u001b[48;2;13;13;13m                                                             \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;"]
[0.000, "o", "13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\r\n\u001b[64;1H\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Screw it, let’s stir the pot a bit. I’ll throw out a bet of 600. Let’s see if they bite!\"\u001b[0m\u001b[48;2;13;13;13m                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\r\n\u001b[65;1H\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                                                                               \u001b[0m\u001b[7;38;2;0;48;84;48;2;13;13;"]
