[0.000, "o", "lays better \u001b[0m\u001b[48;2;13;13;13m         \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[34;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[34;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[34;165H\r\n\u001b[35;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[35;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mpost-flop? But I’ve got the chips to play with, and I’ve seen The Joker make moves before that seemed strong but were just smoke and mirrors.\"\u001b[0m\u001b[48;2;13;13;13m               \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[35;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[35;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[35;165H\r\n\u001b[36;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[36;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Now, I could just call the 1500 and see what the flop brings. That gives me a chance to get some value if I hit, or I could raise it all the way up to 8200 \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[36;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[36;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[36;165H\r\n\u001b[37;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[37;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mand make a statement. But raising could scare"]
[0.000, "o", " them off or, heaven forbid, get me in a big pickle if someone has a monster.\"\u001b[0m\u001b[48;2;13;13;13m                                  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[37;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[37;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[37;165H\r\n\u001b[38;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"The pot odds are decent, but the risk of facing a nasty hand is real. Maybe I should just keep my hat on and see what the cards have to say first.\"\u001b[0m\u001b[48;2;13;13;13m         \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[38;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;165H\r\n\u001b[39;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[39;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Screw it, let’s go for it. I’ll call the 1500 and see what treasures the flop holds.\"\u001b[0m\u001b[48;2;13;13;13m                                                                       \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[39;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[39;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[39;165H\r\n\u001b[40;2H\u001b[48;2;13;13;13m"]
