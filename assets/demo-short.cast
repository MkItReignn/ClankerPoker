[0.001, "o", "13;13m \u001b[0m\u001b[34;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[34;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[34;165H\r\n\u001b[35;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[35;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Hmm, but if he has a big pair or ace-king, I could be in a world of hurt. Do I really want to commit more chips here with a hand that plays better \u001b[0m\u001b[48;2;13;13;13m         \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[35;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[35;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[35;165H\r\n\u001b[36;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[36;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mpost-flop? But I’ve got the chips to play with, and I’ve seen The Joker make moves before that seemed strong but were just smoke and mirrors.\"\u001b[0m\u001b[48;2;13;13;13m               \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[36;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[36;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[36;165H\r\n\u001b[37;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[37;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Now, I could just call the 1500 and see what the flop brings. That gives me a c"]
[0.000, "o", "hance to get some value if I hit, or I could raise it all the way up to 8200 \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[37;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[37;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[37;165H\r\n\u001b[38;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mand make a statement. But raising could scare them off or, heaven forbid, get me in a big pickle if someone has a monster.\"\u001b[0m\u001b[48;2;13;13;13m                                  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[38;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;165H\r\n\u001b[39;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[39;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"The pot odds are decent, but the risk of facing a nasty hand is real. Maybe I should just keep my hat on and see what the cards have to say first.\"\u001b[0m\u001b[48;2;13;13;13m         \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[39;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[39;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[39;165H\r\n\u001b[40;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[40;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13"]
[0.000, "o", ";13;13m\"Screw it, let’s go for it. I’ll call the 1500 and see what treasures the flop holds.\"\u001b[0m\u001b[48;2;13;13;13m                                                                       \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[40;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[40;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[40;165H\r\n\u001b[41;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                                                                               \u001b[0m\u001b[41;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[41;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[41;165H\r\n\u001b[42;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[42;3H\u001b[3;38;2;241;91;181;48;2;13;13;13mPatrick the Star:\u001b[0m\u001b[48;2;13;13;13m                                                                                                                                              \u001b[0m\u001b[42;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[42;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[42;165H\r\n\u001b[43;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[43;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48"]
[0.000, "o", ";2;13;13;13m\"Ooh, look at these cards, Queen of diamonds and a nine of clubs, that's like a fancy sandwich or something, but not matching colors, huh. Everyone's tossing\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[43;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[43;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[43;165H\r\n\u001b[44;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[44;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13min chips already, The Joker's raising from way early like he's got a big joke up his sleeve, and then Agent 007 calls all cool like in the movies, and Jack \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[44;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[44;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[44;165H\r\n\u001b[45;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[45;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mSparrow the pirate calls too, probably hunting for gold in the pot. Pot's getting big, 2400 already, and I just gotta put in 1200 more from my big blind \u001b[0m\u001b[48;2;13;13;13m    \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[45;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[45;164H\u001b[48;2;13;13;13m \u001b[0m\u001b"]
[0.000, "o", "[45;165H\r\n\u001b[46;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[46;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mspot, which is like the comfy couch of poker positions, right? Wait, am I supposed to fold because it's boring? Nah, folding is like going home early from a \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[46;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[46;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[46;165H\r\n\u001b[47;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[47;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mparty. Calling would be friendly, we could all see the flop together and maybe someone wins and we're all happy. But ooh, raising sounds fun, like splashing \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[47;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[47;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[47;165H\r\n\u001b[48;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[48;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13min the water, and my stack's pretty big, 9400, I could raise to... um, something random, like 2500, because 25 is half of 50 and that rhymes with... wait, \u001b[0m\u001b[48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;162H"]
