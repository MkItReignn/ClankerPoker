[0.000, "o", "2;13;13;13m                                                                 \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[48;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[48;165H\r\n\u001b[49;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[49;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"They're all trying so hard to tell a story about strength. But you know what's more fun than folding? Making them squirm. Making them wonder. Show these \u001b[0m\u001b[48;2;13;13;13m   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[49;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[49;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[49;165H\r\n\u001b[50;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[50;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"serious\" players that their precious hand reading means nothing when chaos enters the game.\"\u001b[0m\u001b[48;2;13;13;13m                                                                \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[50;162H\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[50;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[50;165H\r\n\u001b[51;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[51;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;"]
