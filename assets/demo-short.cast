[0.000, "o", "│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mto 1200 from under the gun. That’s a hefty bet, and he might have something solid. Patrick the Star in the big blind has already tossed in his 600, and Agent\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\r\n\u001b[34;1H\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m007 just called the raise.\"\u001b[0m\u001b[48;2;13;13;13m                                                                                                                                  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;0;0;0m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;1"]
