[0.000, "o", "on on our friend 007, who's probably sweating bullets right now.\"\u001b[0m\u001b[48;2;13;13;13m           \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\r\n\u001b[63;1H\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Sometimes the best way to create chaos is to do the \"wrong\" thing for the right reasons. Let's give them something to think about.\"\u001b[0m\u001b[48;2;13;13;13m                         \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[7;38;2;0;48;84;48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[38;2;1;120;212;48;2;13;13;13m│\u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                         "]
