[0.000, "o", " \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[40;268H\r\n\u001b[41;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[41;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13msitting around 16 big blinds. The \"correct\" play would be to shove here... which is exactly why we shouldn't!\"\u001b[0m\u001b[48;2;13;13;13m                                                 \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[41;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[41;165H\r\n\u001b[41;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[41;268H\r\n\u001b[42;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[42;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"*adjusts tie* You see, chaos isn't about being random - it's about being unpredictable while still having a plan. If we min-raise here to 1200, we'll drive \u001b[0m\u001b[48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[42;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[42;165H\r\n\u001b[42;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                          "]
[0.000, "o", "                                         \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[42;268H\r\n\u001b[43;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[43;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13mthem absolutely crazy. They'll be thinking \"Is he strong? Is he weak? Has he lost his mind?\" And that's exactly where we want them.\"\u001b[0m\u001b[48;2;13;13;13m                           \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[43;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[43;165H\r\n\u001b[43;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                                                                                                   \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[43;268H\r\n\u001b[44;2H\u001b[48;2;13;13;13m \u001b[0m\u001b[44;3H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;223;223;223;48;2;13;13;13m\"Plus, look at our position - UTG with the whole table to act behind us. A min-raise here looks so suspicious it might just work. And if someone shoves over \u001b[0m\u001b[48;2;13;13;13m  \u001b[0m\u001b[48;2;13;13;13m \u001b[0m\u001b[44;164H\u001b[48;2;13;13;13m \u001b[0m\u001b[44;165H\r\n\u001b[44;167H\u001b[48;2;13;13;13m \u001b[0m\u001b[38;2;224;224;224;48;2;13;13;13m                  "]
